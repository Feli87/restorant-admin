{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(frontend/src/**)",
      "Write(backend/src/**)",
      "Edit(frontend/src/**)",
      "Edit(backend/src/**)",
      "Bash(cd frontend && npx vitest *)",
      "Bash(cd backend && npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(docker compose *)",
      "Bash(cd backend && npx typeorm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(npm publish *)"
    ]
  }
}
